{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lexeme Construction Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lemma", "source-pos", "category", "uses"],
        "properties": {
          "lemma": { "type": "string", "minLength": 1 },
          "source-pos": { "type": "string", "pattern": "^[a-z_]+$" },
          "category": { "type": "string", "minLength": 1 },
          "uses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "example", "links", "grounds"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
                "label": { "type": "string", "minLength": 1 },
                "example": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 },
                "links": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["construction", "relationship"],
                    "properties": {
                      "construction": { "type": "string", "minLength": 1 },
                      "relationship": { "enum": ["licenses", "occurs-in", "resists"] }
                    }
                  }
                },
                "grounds": {
                  "$ref": "lexicon-override.json#/definitions/grounds"
                }
              }
            }
          }
        }
      }
    }
  }
}
